{
  "name": "scout",
  "version": "0.1.0",
  "description": "Local, autonomous job-hunting pipeline: one editable profile, one-page resumes, human-approved applications.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "smoke:resume": "tsx src/resume/smoke.ts",
    "smoke:discovery": "tsx src/discovery/smoke.ts",
    "smoke:agent": "tsx scripts/smoke-agent.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.12.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "bin": {
    "scout": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanke08/scout.git"
  }
}
